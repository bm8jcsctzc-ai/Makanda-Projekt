# Vorlage für die Einstellungen im Live-Betrieb (bei Vercel unter Settings › Environment Variables eintragen).
# Ohne diese Werte läuft die App lokal mit eingebauter Datenbank und Ordner für Dateien.

# Supabase › Connect › „Transaction pooler“ (Port 6543), [YOUR-PASSWORD] durch das Datenbank-Passwort ersetzen
DATABASE_URL=postgresql://postgres.abcdefghijkl:PASSWORT@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase › Project Settings › API: Project URL und geheimer Schlüssel (sb_secret_… oder service_role)
SUPABASE_URL=https://abcdefghijkl.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...

# Beliebige lange Zufallszeichenkette – schützt die täglichen und wöchentlichen E-Mail-Aufgaben
CRON_SECRET=

# Optional, später: echter E-Mail-Versand über Resend
# RESEND_API_KEY=
# MAIL_ABSENDER="Firmenname <service@firma.de>"
